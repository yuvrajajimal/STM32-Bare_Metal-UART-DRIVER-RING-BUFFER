<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 900 480" width="900" height="480" font-family="Arial, Helvetica, sans-serif" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title>Project layout</title>
  <desc>main.c and uart.c both include uart.h. uart.h includes the CMSIS device header. The startup file, CMSIS headers, linker scripts, and C library stubs come from ST and STM32CubeIDE.</desc>
  <defs>
    <marker id="a" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto">
      <path d="M1 1 L9 5 L1 9 z" fill="#444441"/>
    </marker>
  </defs>
  <rect width="900" height="480" rx="12" fill="#ffffff"/>

  <text x="40" y="38" font-size="15" font-weight="bold" fill="#2c2c2a">Project folder</text>

  <!-- Row 1: the project's own source files -->
  <rect x="40" y="60" width="220" height="112" rx="8" fill="#eeedfe" stroke="#7f77dd" stroke-width="1.5"/>
  <text x="150" y="86" text-anchor="middle" font-size="14" font-weight="bold" fill="#26215c">Src/main.c</text>
  <text x="150" y="110" text-anchor="middle" font-size="13" fill="#26215c">Command line</text>
  <text x="150" y="130" text-anchor="middle" font-size="13" fill="#26215c">line editor + run_command</text>
  <text x="150" y="150" text-anchor="middle" font-size="13" fill="#26215c">uses the driver via uart.h</text>

  <rect x="340" y="60" width="220" height="112" rx="8" fill="#e6f1fb" stroke="#378add" stroke-width="1.5"/>
  <text x="450" y="86" text-anchor="middle" font-size="14" font-weight="bold" fill="#0c447c">Inc/uart.h</text>
  <text x="450" y="110" text-anchor="middle" font-size="13" fill="#0c447c">Interface (the menu)</text>
  <text x="450" y="130" text-anchor="middle" font-size="13" fill="#0c447c">function prototypes</text>
  <text x="450" y="150" text-anchor="middle" font-size="13" fill="#0c447c">RX_SIZE and RX_MASK</text>

  <rect x="640" y="60" width="220" height="112" rx="8" fill="#e1f5ee" stroke="#1d9e75" stroke-width="1.5"/>
  <text x="750" y="86" text-anchor="middle" font-size="14" font-weight="bold" fill="#04342c">Src/uart.c</text>
  <text x="750" y="110" text-anchor="middle" font-size="13" fill="#04342c">Driver (how it is done)</text>
  <text x="750" y="130" text-anchor="middle" font-size="13" fill="#04342c">LED, USART2 setup, ISR</text>
  <text x="750" y="150" text-anchor="middle" font-size="13" fill="#04342c">ring buffer, send functions</text>

  <line x1="262" y1="116" x2="338" y2="116" stroke="#444441" stroke-width="2" marker-end="url(#a)"/>
  <text x="300" y="107" text-anchor="middle" font-size="12" font-style="italic" fill="#5f5e5a">#include</text>
  <line x1="638" y1="116" x2="562" y2="116" stroke="#444441" stroke-width="2" marker-end="url(#a)"/>
  <text x="600" y="107" text-anchor="middle" font-size="12" font-style="italic" fill="#5f5e5a">#include</text>

  <!-- uart.h to CMSIS header -->
  <line x1="450" y1="174" x2="450" y2="250" stroke="#444441" stroke-width="2" marker-end="url(#a)"/>
  <text x="462" y="200" font-size="12" font-style="italic" fill="#5f5e5a">#include stm32f446xx.h</text>

  <!-- Row 2: provided by ST and STM32CubeIDE -->
  <rect x="40" y="212" width="820" height="188" rx="10" fill="none" stroke="#b4b2a9" stroke-width="1.5" stroke-dasharray="6 4"/>
  <text x="56" y="234" font-size="13" fill="#5f5e5a">From ST and STM32CubeIDE (boilerplate, not rewritten)</text>

  <rect x="60" y="252" width="240" height="132" rx="8" fill="#f1efe8" stroke="#888780" stroke-width="1.5"/>
  <text x="180" y="278" text-anchor="middle" font-size="14" font-weight="bold" fill="#2c2c2a">Startup file</text>
  <text x="180" y="302" text-anchor="middle" font-size="12" fill="#2c2c2a">Startup/startup_stm32f446retx.s</text>
  <text x="180" y="322" text-anchor="middle" font-size="12" fill="#2c2c2a">reset code and the vector table</text>
  <text x="180" y="342" text-anchor="middle" font-size="12" fill="#2c2c2a">(where USART2_IRQHandler is</text>
  <text x="180" y="358" text-anchor="middle" font-size="12" fill="#2c2c2a">looked up)</text>

  <rect x="330" y="252" width="240" height="132" rx="8" fill="#f1efe8" stroke="#888780" stroke-width="1.5"/>
  <text x="450" y="278" text-anchor="middle" font-size="14" font-weight="bold" fill="#2c2c2a">CMSIS device headers</text>
  <text x="450" y="302" text-anchor="middle" font-size="12" fill="#2c2c2a">Inc/stm32f446xx.h and related files</text>
  <text x="450" y="322" text-anchor="middle" font-size="12" fill="#2c2c2a">register addresses and bit names</text>
  <text x="450" y="342" text-anchor="middle" font-size="12" fill="#2c2c2a">(USART2, RCC, NVIC_EnableIRQ)</text>

  <rect x="600" y="252" width="240" height="132" rx="8" fill="#f1efe8" stroke="#888780" stroke-width="1.5"/>
  <text x="720" y="278" text-anchor="middle" font-size="14" font-weight="bold" fill="#2c2c2a">Linker and library files</text>
  <text x="720" y="302" text-anchor="middle" font-size="12" fill="#2c2c2a">STM32F446RETX_FLASH.ld, _RAM.ld</text>
  <text x="720" y="322" text-anchor="middle" font-size="12" fill="#2c2c2a">Src/syscalls.c, Src/sysmem.c</text>
  <text x="720" y="342" text-anchor="middle" font-size="12" fill="#2c2c2a">memory layout and C library support</text>

  <!-- Footer -->
  <text x="40" y="428" font-size="12" fill="#5f5e5a">Also in the repo: README.md, .gitignore, images/</text>

  <rect x="40" y="444" width="14" height="14" rx="3" fill="#eeedfe" stroke="#7f77dd"/>
  <rect x="58" y="444" width="14" height="14" rx="3" fill="#e6f1fb" stroke="#378add"/>
  <rect x="76" y="444" width="14" height="14" rx="3" fill="#e1f5ee" stroke="#1d9e75"/>
  <text x="98" y="456" font-size="12" fill="#2c2c2a">Project source files (main.c, uart.h, uart.c)</text>
  <rect x="370" y="444" width="14" height="14" rx="3" fill="#f1efe8" stroke="#888780"/>
  <text x="390" y="456" font-size="12" fill="#2c2c2a">Provided by ST / STM32CubeIDE</text>
